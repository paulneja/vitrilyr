[Desktop Entry]
Type=Application
Name=Vitrilyr
Comment=Spotify lyrics on your Linux desktop
Comment[es]=Letras de Spotify en tu escritorio Linux
Comment[zh_CN]=Linux 桌面的 Spotify 歌词
Exec=vitrilyr
Icon=audio-x-generic
Terminal=false
Categories=AudioVideo;Audio;
StartupNotify=false
Actions=Settings;Toggle;

[Desktop Action Settings]
Name=Settings
Name[es]=Ajustes
Name[zh_CN]=设置
Exec=vitrilyr settings

[Desktop Action Toggle]
Name=Show / Hide
Name[es]=Mostrar / ocultar
Name[zh_CN]=显示 / 隐藏
Exec=vitrilyr toggle
